#!/usr/bin/env bash
#
# ticket - thin launcher for the TypeScript CLI.
#
# ZERO ticket logic lives here. Every command, every byte of output and every exit code
# comes from dist/ticket.mjs (sources in src/). This file only:
#   1. finds its own checkout, through symlinks (it is installed on PATH as `tk`),
#   2. makes sure the bundle exists and is no older than src/, building it on demand,
#   3. exec's node, replacing itself so the CLI owns the process.
#
# WHY build-on-demand rather than a committed/released bundle: distribution is
# build-from-source (owner decision, 2026-07-30), so a fresh clone - or a `git pull` that
# changes src/ - must produce a current bundle without the user knowing there is a build
# step at all.
set -euo pipefail

# EVERYTHING this script prints goes to STDERR. `tk query | jq` and `tk ls | head` must see
# the CLI's bytes and nothing else, including on the invocation that builds the bundle.
_log() { printf 'ticket: %s\n' "$*" >&2; }
_fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }

_require_command() {
    command -v "$1" >/dev/null 2>&1 || _fail "$1 is required but is not on PATH${2:-}"
}

# The directory holding this script, with every symlink resolved: `tk` on PATH is typically
# a symlink into the checkout, and the bundle and the sources sit next to the REAL file,
# never next to the link.
_script_dir() {
    local source="${BASH_SOURCE[0]}" link_dir
    while [[ -L "$source" ]]; do
        link_dir=$(cd -P -- "$(dirname -- "$source")" && pwd)
        source=$(readlink -- "$source")
        # A relative link target resolves against the directory holding the LINK.
        [[ "$source" == /* ]] || source="$link_dir/$source"
    done
    cd -P -- "$(dirname -- "$source")" && pwd
}

SCRIPT_DIR=$(_script_dir)
readonly SCRIPT_DIR
readonly BUNDLE="$SCRIPT_DIR/dist/ticket.mjs"
readonly SOURCE_DIR="$SCRIPT_DIR/src"

# Rebuild when there is no bundle, or when any source file is newer than it - a `git pull`
# must not leave a stale bundle serving stale behavior. `-print -quit` stops at the first
# hit, so the hot path costs exactly one find over src/.
_bundle_is_stale() {
    [[ -f "$BUNDLE" ]] || return 0
    # Installed without sources: the bundle is all there is, so it cannot be stale.
    [[ -d "$SOURCE_DIR" ]] || return 1
    [[ -n "$(find "$SOURCE_DIR" -newer "$BUNDLE" -print -quit)" ]]
}

# Concurrent invocations racing on the same build are ACCEPTED (single-user tool): locking
# would buy nothing here and is real complexity.
_build_bundle() {
    [[ -d "$SOURCE_DIR" ]] ||
        _fail "no bundle at [$BUNDLE] and no sources at [$SOURCE_DIR] to build one from"
    _require_command npm " (install Node.js, which ships npm)"
    _log "building [$BUNDLE]"
    (
        cd "$SCRIPT_DIR"
        # esbuild is a devDependency, so a fresh clone has no node_modules at all.
        if [[ ! -x node_modules/.bin/esbuild ]]; then
            npm install --no-audit --no-fund --silent
        fi
        npm run --silent build
    ) >&2 ||
        _fail "failed to build [$BUNDLE]; run 'npm install && npm run build' in [$SCRIPT_DIR] to see why"
    # A build that "succeeded" without producing the bundle must not reach the exec below.
    [[ -f "$BUNDLE" ]] || _fail "build produced no bundle at [$BUNDLE]"
}

_require_command node " (install Node.js)"
if _bundle_is_stale; then
    _build_bundle
fi

# TICKET_INVOKED_AS: node cannot see this script's $0, and usage text interpolates it.
TICKET_INVOKED_AS="$0" exec node "$BUNDLE" "$@"
